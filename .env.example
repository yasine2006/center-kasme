# ── Base de données ────────────────────────────────────────────────────────
# Développement local (docker compose, port 5434)
DATABASE_URL="postgresql://school:school@127.0.0.1:5434/school?schema=public"

# Production Neon — runtime Vercel : utiliser l'URL "pooled" (avec -pooler)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Production Neon — migrations : utiliser l'URL "direct" (sans -pooler)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Secrets ────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="changer-ceci-par-une-chaine-aleatoire-forte"
CRON_SECRET="changer-ceci-par-une-autre-chaine-aleatoire-forte"

# ── Bootstrap (première installation uniquement) ───────────────────────────
# Utilisés par : npm run db:bootstrap
SCHOOL_NAME="Nom du centre"
SCHOOL_EMAIL="contact@exemple.ma"
SCHOOL_PHONE="0522 00 00 00"
SCHOOL_ADDRESS="Adresse, Ville"
ADMIN_NAME="Administrateur"
ADMIN_EMAIL="admin@exemple.ma"
ADMIN_PASSWORD="MotDePasseFort123!"
